# Dev image: siapkan deps saja, kode di-mount saat run (lihat docker-compose.dev.yml).
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

EXPOSE 3000

# Entrypoint aktual di-override compose (cek node_modules dulu agar start cepat).
CMD ["npm", "run", "dev"]
