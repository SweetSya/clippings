# ==========================================
# Database Configuration
# ==========================================
# Untuk local development tanpa MySQL, gunakan SQLite:
DATABASE_URL=sqlite+aiosqlite:///./storage/autoshorts.db
# Untuk Docker Compose (MySQL 8.0):
# DATABASE_URL=mysql+asyncmy://autoshorts:autoshorts_secure_password@db-mysql:3306/autoshorts
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=autoshorts
MYSQL_USER=autoshorts
MYSQL_PASSWORD=change_me

# ==========================================
# Security & Cryptography
# ==========================================
JWT_SECRET=generate_dengan_openssl_rand_hex_32
SETTINGS_ENCRYPTION_KEY=base64_32_byte_key

# ==========================================
# Storage & Application Limits
# ==========================================
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=2048
MIN_CLIP_SECONDS=10
MAX_CLIP_SECONDS=90
AUTO_CLEANUP_DAYS=0

# ==========================================
# Worker Concurrency
# ==========================================
TRANSCRIBE_CONCURRENCY=1
RENDER_CONCURRENCY=2

# ==========================================
# Faster-Whisper Configuration
# ==========================================
# Model: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Device: cpu | cuda
WHISPER_DEVICE=cpu
# Compute Type: int8 | float16 | int8_float16
WHISPER_COMPUTE_TYPE=int8

# ==========================================
# Smart Reframe (Head-Tracking Crop)
# ==========================================
# Jadikan smart crop sebagai default untuk Auto-Generate Shorts
SMART_CROP_DEFAULT=true
# Jumlah frame yang dideteksi per detik saat memetakan posisi kepala
REFRAME_SAMPLE_FPS=2.0
# Batas jumlah keyframe pada ekspresi crop FFmpeg
REFRAME_MAX_KEYFRAMES=150
# Nama berkas model deteksi wajah di backend/app/assets/
REFRAME_MODEL_FILENAME=face_detection_yunet_2023mar.onnx

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=/api
